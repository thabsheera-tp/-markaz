{
  "name": "koyyam-markaz-monorepo",
  "version": "1.0.0",
  "description": "Full-Stack Web Application for Koyyam Markaz (MARKAZU DA-WATHIL ISLAMIYYA)",
  "private": true,
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "node run-dev.js",
    "tunnel": "node tunnel.mjs",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm run install:backend && npm run install:frontend"
  },
  "keywords": [
    "koyyam-markaz",
    "islamic-institution",
    "react",
    "express",
    "sqlite",
    "tailwind"
  ],
  "author": "Koyyam Markaz Development Team",
  "license": "ISC",
  "dependencies": {
    "localtunnel": "^2.0.2",
    "untun": "^0.2.2"
  }
}
