# ==========================================
# Koyyam Markaz - Full-Stack Next.js Config
# ==========================================

# Port (default: 3000)
PORT=3000
NODE_ENV=production

# Canonical Domain / Public Site URL (for SEO, OpenGraph previews, sitemap & robots)
NEXT_PUBLIC_SITE_URL=https://koyyammarkaz.com

# Authentication (Must be a strong random 32+ character string in production)
JWT_SECRET=your_super_secret_random_jwt_key_min_32_characters_long

# Supabase PostgreSQL Database (Required for Vercel Serverless)
# Use Transaction Pooler (port 6543) or Direct Connection (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase API & Cloud Storage (for images and public CDN)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
